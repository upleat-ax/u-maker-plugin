  "phaseGates": {
    "plan-to-design": {
      "common": [
        "1_Roadmap_PM.md"
      ],
      "perApp": [
        "1_SRS_RA.md",
        "1_IA_RA.md"
      ],
      "status": "Final",
      "validator": "u-agent-ra"
    },
    "design-to-do": {
      "common": [
        "2_ERD_SA.md",
        "2_RTM_RA.md",
        "2_UXGuide_UX.md"
      ],
      "perApp": [
        "2_API_SA.md",
        "2_Screen_UX.md",
        "2_ScreenFlow_UX.md"
      ],
      "status": "Final",
      "validator": "u-agent-ra",
      "additionalCheck": "u-agent-ra-consistency-review"
    },
    "do-to-check": {
      "required": [
        "3_Code_DV.md"
      ],
      "conditions": [
        "code-implementation-complete",
        "build-success"
      ]
    },
    "check-to-complete": {
      "conditions": [
        "critical-major-defects-zero",
        "backlog-items-zero",
        "all-fr-implemented",
        "build-success"
      ]
    },
    "check-to-act": {
      "trigger": "check-to-complete-failed"
    },
    "act-to-plan": {
      "common": [
        "5_IterationLog_RA.md",
        "5_Retrospective_PM.md"
      ],
      "conditions": [
        "retrospective-complete",
        "archive-complete"
      ]
    }
  },
  "exitCriteria": {
    "criticalMajorZero": "Critical/Major defect count is 0 in 4_Report_QA.md",
    "allFrImplemented": "All FR items in 1_SRS_RA.md have status Implemented",
    "buildSuccess": "bun run build passes without errors"
  },
