  "techStack": {
    "rules": [
      {
        "id": "TS-01",
        "rule": "Clean Architecture folder structure",
        "enforce": true
      },
      {
        "id": "TS-02",
        "rule": "react-query for data fetching (usecase pattern forbidden)",
        "enforce": true
      },
      {
        "id": "TS-03",
        "rule": "Plain .css files only (CSS-in-JS forbidden)",
        "enforce": true
      },
      {
        "id": "TS-04",
        "rule": "Next.js App Router",
        "enforce": true
      },
      {
        "id": "TS-05",
        "rule": "eslint-plugin-header forbidden",
        "enforce": true
      },
      {
        "id": "TS-06",
        "rule": "Turborepo monorepo",
        "enforce": true
      },
      {
        "id": "TS-07",
        "rule": "Functional components only (class components forbidden)",
        "enforce": true
      },
      {
        "id": "TS-08",
        "rule": "Storybook for component documentation",
        "enforce": true
      },
      {
        "id": "TS-09",
        "rule": "Design Token based styling",
        "enforce": true
      },
      {
        "id": "TS-10",
        "rule": "bun package manager (npm/yarn/pnpm forbidden)",
        "enforce": true
      }
    ],
    "monorepo": {
      "enabled": false,
      "structure": {
        "apps": [
          "web"
        ],
        "note": "web is a logical interaction surface for slash commands and terminal/markdown flows"
      }
    },
    "languages": [
      "Markdown",
      "JavaScript",
      "Python",
      "Bash",
      "JSON"
    ],
    "runtimes": [
      "node",
      "python3",
      "bash"
    ],
    "interfaces": [
      "slash-commands",
      "hooks",
      "local-scripts",
      "markdown-docs"
    ]
  },
  "conventions": {
    "naming": {
      "components": "PascalCase",
      "functions": "camelCase",
      "constants": "UPPER_SNAKE_CASE",
      "files": "kebab-case"
