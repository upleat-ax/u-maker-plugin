{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-export.schema.json",
  "title": "JSON Export",
  "description": "Schema for JSON companion files generated alongside SSoT markdown documents",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "description": "Document metadata from YAML frontmatter",
      "properties": {
        "owner": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Review", "Final"] },
        "version": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date" },
        "relatedDocs": { "type": "array", "items": { "type": "string" } },
        "app": { "type": "string" }
      },
      "required": ["owner", "status", "version", "lastUpdated", "app"]
    },
    "docType": {
      "type": "string",
      "enum": [
        "srs",
        "ia",
        "roadmap",
        "erd",
        "api",
        "screens",
        "screen-flow",
        "ux-guide",
        "rtm",
        "testcase",
        "iteration-log",
        "retrospective",
        "classified",
        "glossary",
        "backlog",
        "index",
        "common-ra",
        "design-system"
      ],
      "description": "Type of the source document"
    },
    "data": {
      "type": "object",
      "description": "Document-type-specific structured data"
    }
  },
  "required": ["meta", "docType", "data"],
  "allOf": [
    {
      "if": { "properties": { "docType": { "const": "srs" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "projectOverview": { "type": "object" },
              "stakeholders": { "type": "array" },
              "requirements": { "type": "array" },
              "nfRequirements": { "type": "array" },
              "userStories": { "type": "array" },
              "features": { "type": "array" },
              "constraints": { "type": "array" },
              "assumptions": { "type": "array" },
              "glossary": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "ia" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "siteMap": { "type": "array" },
              "screenHierarchy": { "type": "array" },
              "navigationPatterns": { "type": "array" },
              "userFlows": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "roadmap" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "milestones": { "type": "array" },
              "iterations": { "type": "array" },
              "dependencies": { "type": "array" },
              "risks": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "erd" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "entities": { "type": "array" },
              "relations": { "type": "array" },
              "commonTables": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "api" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "baseUrl": { "type": "string" },
              "apiVersion": { "type": "string" },
              "authMethod": { "type": "string" },
              "endpoints": { "type": "array" },
              "errorCodes": { "type": "array" },
              "commonHeaders": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "screens" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "screens": { "type": "array" },
              "breakpoints": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "screen-flow" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "navigationMap": { "type": "array" },
              "journeyFlows": { "type": "array" },
              "transitionRules": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "rtm" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "traceabilityRows": { "type": "array" },
              "frCoverage": { "type": "array" },
              "summary": { "type": "object" },
              "gaps": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "testcase" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "testCases": { "type": "array" },
              "ftCoverage": { "type": "array" },
              "prioritySummary": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "iteration-log" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "iterationNumber": { "type": "integer" },
              "dateRange": { "type": "object" },
              "plannedItems": { "type": "array" },
              "completedItems": { "type": "array" },
              "incompleteItems": { "type": "array" },
              "velocity": { "type": "object" },
              "backlogChanges": { "type": "array" },
              "decisions": { "type": "array" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "docType": { "const": "retrospective" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "iterationNumber": { "type": "integer" },
              "keepItems": { "type": "array" },
              "problemItems": { "type": "array" },
              "tryItems": { "type": "array" },
              "actionItems": { "type": "array" },
              "metrics": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
