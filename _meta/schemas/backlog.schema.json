{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backlog.schema.json",
  "title": "Backlog Item",
  "description": "Schema for backlog items tracked in iteration logs",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique backlog item identifier"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bug", "improvement", "tech-debt"],
      "description": "Type of backlog item"
    },
    "title": {
      "type": "string",
      "description": "Short title of the backlog item"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the backlog item"
    },
    "priority": {
      "type": "string",
      "enum": ["must", "should", "could", "wont"],
      "description": "MoSCoW priority classification"
    },
    "storyPoints": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated effort in story points"
    },
    "iteration": {
      "type": ["integer", "null"],
      "description": "Assigned iteration number, null if unassigned"
    },
    "status": {
      "type": "string",
      "enum": ["backlog", "todo", "in-progress", "review", "done", "blocked"],
      "description": "Current status of the item"
    },
    "assignee": {
      "type": ["string", "null"],
      "description": "Agent or person assigned to the item"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["classified", "retro", "gap-analysis", "manual", "discuss"],
          "description": "Origin of the backlog item"
        },
        "ref": {
          "type": "string",
          "description": "Reference ID or path to the source"
        }
      },
      "required": ["type", "ref"]
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags/labels for categorization"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of items this depends on"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last updated timestamp"
    }
  },
  "required": ["id", "type", "title", "description", "priority", "status", "source", "created", "updated"]
}
