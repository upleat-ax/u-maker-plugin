{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deploy Manifest",
  "description": "Source-of-truth for deploy-phase artifacts in PBGD workflow (v4.0). Tracks target platform, artifact set, gate score, and source hashes for continuous regeneration.",
  "type": "object",
  "required": ["version", "target", "artifacts", "gate", "sourceHashes", "generatedAt"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Deploy manifest schema version",
      "const": "1.0"
    },
    "target": {
      "type": "object",
      "required": ["platforms"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "vercel",
              "netlify",
              "cloudflare-pages",
              "github-pages",
              "docker",
              "cloud-run",
              "aws-amplify",
              "aws-ecs",
              "aws-lambda",
              "kubernetes",
              "fly-io",
              "railway",
              "render",
              "custom"
            ]
          },
          "description": "Deploy target platforms chosen by user at invocation"
        },
        "customPlatformName": {
          "type": "string",
          "description": "Required when 'custom' is in platforms"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "path", "status"],
        "properties": {
          "type": {
            "enum": [
              "ci-pipeline",
              "platform-config",
              "deploy-script",
              "runbook",
              "env-template",
              "release-notes",
              "smoke-test"
            ]
          },
          "path": {
            "type": "string",
            "description": "Relative path to generated artifact"
          },
          "status": {
            "enum": ["fresh", "stale", "generating", "error"],
            "description": "fresh=in-sync with sources; stale=source changed, needs regen"
          },
          "generatedFrom": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Template paths used to generate this artifact"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["docScore", "deployReady"],
      "properties": {
        "docScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Gatekeeping avg score at time of deploy manifest generation"
        },
        "deployThreshold": {
          "type": "number",
          "default": 98
        },
        "deployReady": {
          "type": "boolean",
          "description": "True iff docScore >= deployThreshold"
        },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "sourceHashes": {
      "type": "object",
      "description": "SHA-256 of upstream SSoT documents; used to detect staleness for continuous regen",
      "properties": {
        "srs": { "type": "string" },
        "ia": { "type": "string" },
        "erd": { "type": "string" },
        "api": { "type": "string" },
        "screens": { "type": "string" },
        "designSystem": { "type": "string" },
        "testcases": { "type": "string" },
        "testResults": { "type": "string" },
        "codeTreeHash": { "type": "string", "description": "Aggregate hash of generated FE/BE/DB code tree" }
      },
      "additionalProperties": { "type": "string" }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": {
      "type": "string",
      "description": "Agent that produced this manifest",
      "default": "u-agent-deploy"
    }
  }
}
