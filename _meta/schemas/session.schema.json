{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "Discussion Session",
  "description": "Schema for /u-discuss sessions (brainstorm, review, decision, workshop, retro)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "type": {
      "type": "string",
      "enum": ["brainstorm", "review", "decision", "workshop", "retro"],
      "description": "Session type determining protocol rules"
    },
    "topic": {
      "type": "string",
      "description": "Main discussion topic"
    },
    "scope": {
      "type": "string",
      "description": "Scope or boundary of the discussion"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed"],
      "description": "Current session status"
    },
    "participants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of participants (agents and/or humans)"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Session start timestamp"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["idea", "decision", "concern", "action"],
            "description": "Type of session item"
          },
          "text": {
            "type": "string",
            "description": "Content of the item"
          },
          "author": {
            "type": "string",
            "description": "Who contributed this item"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the item was recorded"
          }
        },
        "required": ["type", "text", "author", "timestamp"]
      },
      "description": "Chronological list of session items"
    },
    "transcript": {
      "type": "string",
      "description": "Full session transcript"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated session summary"
    }
  },
  "required": ["id", "type", "topic", "status", "participants", "startedAt", "items"]
}
