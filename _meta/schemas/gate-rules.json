{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase Gate Rules",
  "description": "Rules defining conditions for PDCA phase transitions",
  "gates": {
    "plan-to-design": {
      "required": [
        { "doc": "srs", "status": "Final" },
        { "doc": "ia", "status": "Final" },
        { "doc": "roadmap", "status": "Review" }
      ]
    },
    "design-to-do": {
      "required": [
        { "doc": "erd", "status": "Final" },
        { "doc": "rtm", "status": "Final" },
        { "doc": "screens", "status": "Final" },
        { "doc": "api", "status": "Final" }
      ],
      "checks": ["consistency-review"]
    },
    "do-to-check": {
      "required": [
        { "condition": "code-complete" },
        { "condition": "build-success" }
      ]
    },
    "check-to-complete": {
      "required": [
        { "condition": "critical-defects-zero" },
        { "condition": "major-defects-zero" },
        { "condition": "all-fr-implemented" },
        { "condition": "build-success" }
      ]
    }
  }
}
