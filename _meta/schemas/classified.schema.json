{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classified.schema.json",
  "title": "Classified Items",
  "description": "Schema for classified items extracted from raw input data by u-ingest",
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^(FR|NR)-\\d{4}$" },
          "type": { "type": "string", "enum": ["FR", "NR"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "source": { "$ref": "#/$defs/source" },
          "related": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["extracted", "validated", "adopted", "rejected"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "type", "title", "description", "priority", "source", "status"]
      }
    },
    "pain-points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "affected_users": { "type": "array", "items": { "type": "string" } },
          "current_workaround": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "description", "severity", "source"]
      }
    },
    "domain-terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "term": { "type": "string" },
          "definition": { "type": "string" },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "context": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "term", "definition", "source"]
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "department": { "type": "string" },
          "needs": { "type": "array", "items": { "type": "string" } },
          "pain_points": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "name", "role", "source"]
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "actors": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": { "type": "integer" },
                "action": { "type": "string" },
                "actor": { "type": "string" },
                "system": { "type": "string" }
              },
              "required": ["order", "action"]
            }
          },
          "systems": { "type": "array", "items": { "type": "string" } },
          "pain_points": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "name", "steps", "source"]
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "functions": { "type": "array", "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } },
          "screenshot_path": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "name", "source"]
      }
    },
    "data-models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "table_name": { "type": "string" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "pk": { "type": "boolean" },
                "fk": { "type": "string" },
                "nullable": { "type": "boolean" },
                "description": { "type": "string" }
              },
              "required": ["name", "type"]
            }
          },
          "relations": { "type": "array", "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "table_name", "columns", "source"]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["tech", "policy", "legal"] },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "type", "description", "source"]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "participants": { "type": "array", "items": { "type": "string" } },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "date", "decision", "rationale", "source"]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "context": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "answer": { "type": "string" },
          "source": { "$ref": "#/$defs/source" }
        },
        "required": ["id", "question", "status", "source"]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "page": { "type": ["integer", "null"] },
        "section": { "type": "string" }
      },
      "required": ["file"]
    }
  }
}
