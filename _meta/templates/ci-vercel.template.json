{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_generatedBy": "/u-deploy v{{pluginVersion}}",
  "_generatedAt": "{{generatedAt}}",
  "_note": "Re-running /u-deploy regenerates this file. Manual edits under '_keep' are preserved.",
  "version": 2,
  "name": "{{appName}}",
  "builds": [
    {{#buildEntries}}
    { "src": "{{src}}", "use": "{{use}}" }{{#unless @last}},{{/unless}}
    {{/buildEntries}}
  ],
  "routes": [
    {{#routes}}
    { "src": "{{src}}", "dest": "{{dest}}" }{{#unless @last}},{{/unless}}
    {{/routes}}
  ],
  "env": {
    {{#envVars}}
    "{{name}}": "@{{name | lowercase}}"{{#unless @last}},{{/unless}}
    {{/envVars}}
  },
  "_keep": {}
}
