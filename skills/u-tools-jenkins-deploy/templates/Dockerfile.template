# syntax=docker/dockerfile:1.7
#
# {{APP_PATH}} — production Docker image (Next.js 15 + Turborepo + Bun monorepo template).
#
# Build context: 레포 루트 (build.sh 가 cd 후 실행). monorepo 구조상 workspace 패키지 가 모두
# 필요하므로 {{APP_NAME}} 디렉터리만 컨텍스트로 쓰면 bun install 이 깨진다.
#
#   docker build -f {{APP_PATH}}/docker/Dockerfile -t {{NS}}/{{IMAGE}}:latest .
#
# 다른 스택용 변형 힌트:
#   - pnpm/npm/yarn 사용: bun → 해당 매니저, --frozen-lockfile → 동등 옵션
#   - 비-모노레포: deps stage 의 workspace package.json COPY 블록 전체 제거
#   - 비-Panda: builder 의 panda 캐시 mount + runner 의 styled-system COPY 제거
#   - 비-Next.js: runner CMD 와 EXPOSE / PORT 환경변수 변경

# ─── Stage 1: deps — workspace install only ────────────────────────────────
FROM oven/bun:1.2 AS deps
WORKDIR /app

COPY package.json bun.lock turbo.json ./
# 모든 declared workspace 의 manifest 가 있어야 bun install --frozen-lockfile 통과.
# bun install 은 모든 workspace 를 처리해야 하므로 이 앱만 빌드해도 다른 앱들의
# package.json 이 필요. 다른 앱의 source 는 .dockerignore 로 제외하지만 manifest 는
# `!apps/{x}/package.json` 으로 재포함.
{{WORKSPACE_PACKAGE_JSON_COPIES}}

# BuildKit cache mount — 빌드 간 bun 패키지 캐시 유지.
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile

# ─── Stage 2: builder ──────────────────────────────────────────────────────
FROM oven/bun:1.2 AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# 빌드타임 env (NEXT_PUBLIC_*) — Next.js 가 build 시점에 client bundle 에 inline 한다.
# Jenkins pipeline 이 grigo-bugo-env-prod 같은 secret-file 에서 source → --build-arg 로 주입.
{{BUILD_ARG_BLOCK}}

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Turborepo filter — 이 앱과 직접 의존 패키지만 빌드.
# Cache mounts:
#  - .next/cache : Next.js incremental compile (가장 큰 한 방)
#  - .turbo      : Turborepo task 캐시
RUN --mount=type=cache,target=/app/{{APP_PATH}}/.next/cache,sharing=locked \
    --mount=type=cache,target=/app/.turbo,sharing=locked \
    bun run build --filter {{PACKAGE_NAME}}

# ─── Stage 3: runner ───────────────────────────────────────────────────────
FROM oven/bun:1.2-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT={{APP_PORT}}
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs

# 런타임 산출물 — 이 앱이 실제로 필요로 하는 것만.
COPY --from=builder --chown=nextjs:nodejs /app/{{APP_PATH}}/.next ./{{APP_PATH}}/.next
COPY --from=builder --chown=nextjs:nodejs /app/{{APP_PATH}}/public ./{{APP_PATH}}/public
COPY --from=builder --chown=nextjs:nodejs /app/{{APP_PATH}}/next.config.ts ./{{APP_PATH}}/next.config.ts
COPY --from=builder --chown=nextjs:nodejs /app/{{APP_PATH}}/package.json ./{{APP_PATH}}/package.json
{{RUNTIME_PACKAGES_COPIES}}
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json /app/bun.lock /app/turbo.json ./

USER nextjs
EXPOSE {{APP_PORT}}

# Container 자체 HEALTHCHECK 는 두지 않는다 — oven/bun:1.2-slim 에 wget/curl 이
# 없어 항상 (unhealthy) 표시되는 노이즈. Jenkins Deploy 단계가 외부에서 probe 한다.

WORKDIR /app/{{APP_PATH}}
CMD ["bun", "run", "start"]
