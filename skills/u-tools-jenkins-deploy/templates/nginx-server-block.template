# /data/nginx/sites-enabled/{{DOMAIN}}
# {{JOB_NAME}} — container on port {{APP_PORT}}, fronted by nginx + Let's Encrypt.
#
# Cert source:
#   - {{IF WILDCARD_CERT}}wildcard *.{{APEX_DOMAIN}} (existing) — no issuance needed.{{ENDIF}}
#   - {{IF NEW_CERT}}new cert issued for {{DOMAIN}} via webroot acme challenge.{{ENDIF}}

server {
    listen 80;
    server_name {{DOMAIN}};

    # Certbot HTTP-01 challenge — kept for cert renewal even when current
    # cert is wildcard (DNS-01 issued).
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # 영정사진 / 계약첨부 등 대용량 업로드 대응 — grigo 패밀리 패턴.
    # 다른 앱에선 기본값(1m) 으로 충분할 수 있음.
    client_max_body_size {{MAX_BODY_SIZE}};

    location / {
        proxy_pass http://172.17.0.1:{{APP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        'upgrade';
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
