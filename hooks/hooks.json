{
  "description": "u-maker reactive hooks — keep dropzone index, doc<->JSON sync, gate loop state, and deploy staleness in sync after file mutations. Each hook is dispatched through _dispatch.js, which bridges Claude Code's stdin contract to the per-event Node modules in this folder.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/_dispatch.js\" on-dropzone-added",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/_dispatch.js\" on-doc-change",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/_dispatch.js\" on-gate-result",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/_dispatch.js\" on-deploy-state",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
