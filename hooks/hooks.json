{
  "hooks": [
    {
      "event": "PostToolUse",
      "tool": "Write",
      "pattern": ".u-maker/data/dropzone/**",
      "script": "on-dropzone-added.js",
      "timeout": 5000
    },
    {
      "event": "PostToolUse",
      "tool": "Write",
      "pattern": ".u-maker/docs/**/*.md",
      "script": "on-doc-change.js",
      "timeout": 3000
    },
    {
      "event": "PostToolUse",
      "tool": "Write",
      "pattern": ".u-maker/.state/loop-state.json",
      "script": "on-gate-result.js",
      "timeout": 3000
    },
    {
      "event": "PostToolUse",
      "tool": "Write",
      "pattern": ".u-maker/docs/**/*.md",
      "script": "on-deploy-state.js",
      "timeout": 3000
    }
  ]
}
