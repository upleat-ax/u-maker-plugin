{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "u-maker/json-export",
  "title": "JSON Export Schema",
  "description": "모든 SSoT 마크다운 문서와 함께 생성되는 JSON 내보내기 파일의 공통 스키마",
  "type": "object",
  "required": ["document", "version", "status", "owner", "lastUpdated"],
  "properties": {
    "document": {
      "type": "string",
      "description": "문서 식별자 (예: srs, erd, api, screen)"
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "문서 버전 (semver)"
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Review", "Final"],
      "description": "문서 상태"
    },
    "owner": {
      "type": "string",
      "enum": ["u-agent-orchestrator", "u-agent-planner", "u-agent-builder", "u-agent-guardian"],
      "description": "담당 에이전트"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "최종 수정 시각"
    },
    "app": {
      "type": "string",
      "description": "소속 앱 이름 (common이면 생략)"
    },
    "phase": {
      "type": "string",
      "enum": ["01-plan", "02-design", "03-dev", "04-check", "05-act"],
      "description": "소속 Phase"
    },
    "data": {
      "type": "object",
      "description": "문서별 구조화된 데이터. 문서 타입에 따라 스키마 다름."
    }
  }
}
