{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "u-maker/assumption",
  "title": "Assumption Schema",
  "description": "Auto 모드에서 agent가 기록하는 assumption 항목 스키마",
  "type": "object",
  "required": ["id", "agent", "phase", "context", "question", "decided", "rationale", "confidence", "impact", "status", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^A-\\d{3,}$",
      "description": "Assumption 고유 ID"
    },
    "agent": {
      "type": "string",
      "enum": ["orchestrator", "planner", "builder", "guardian"],
      "description": "판단한 에이전트"
    },
    "phase": {
      "type": "string",
      "enum": ["plan", "design", "do", "check", "act"],
      "description": "판단 시점의 phase"
    },
    "context": {
      "type": "string",
      "description": "판단이 필요한 상황 설명"
    },
    "question": {
      "type": "string",
      "description": "실제 질문했어야 할 내용"
    },
    "decided": {
      "type": "string",
      "description": "agent가 내린 결정"
    },
    "rationale": {
      "type": "string",
      "description": "결정 근거"
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "고려한 대안 목록"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "확신도"
    },
    "impact": {
      "type": "array",
      "items": { "type": "string" },
      "description": "영향받는 문서/항목 ID 목록"
    },
    "status": {
      "type": "string",
      "enum": ["pending-review", "approved", "rejected", "superseded"],
      "description": "리뷰 상태"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reviewedBy": {
      "type": ["string", "null"],
      "description": "리뷰어"
    },
    "reviewNote": {
      "type": ["string", "null"],
      "description": "리뷰 코멘트"
    },
    "supersededBy": {
      "type": ["string", "null"],
      "description": "이 assumption을 대체한 assumption ID"
    }
  }
}
