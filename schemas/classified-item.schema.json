{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "u-maker/classified-item",
  "title": "Classified Item Schema",
  "description": "_classified/ 카테고리별 항목의 공통 스키마",
  "type": "object",
  "required": ["id", "category", "title", "source", "status", "extractedAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(FR|NR|PP|DT|SH|WF|SC|DM|CN|DC|QS)-\\d{3,}$",
      "description": "항목 고유 ID"
    },
    "category": {
      "type": "string",
      "enum": ["requirement", "pain-point", "domain-term", "stakeholder", "workflow", "screen-asis", "data-model", "constraint", "decision", "question"],
      "description": "분류 카테고리"
    },
    "title": {
      "type": "string",
      "description": "항목 제목"
    },
    "description": {
      "type": "string",
      "description": "상세 설명"
    },
    "source": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "description": "원본 파일 경로" },
        "page": { "type": ["integer", "null"], "description": "페이지 번호" },
        "section": { "type": ["string", "null"], "description": "섹션 제목" }
      },
      "description": "원본 출처 메타데이터"
    },
    "status": {
      "type": "string",
      "enum": ["extracted", "validated", "adopted", "rejected"],
      "description": "항목 lifecycle 상태"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "분류 태그"
    },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "관련 항목 ID 목록"
    },
    "extractedAt": {
      "type": "string",
      "format": "date-time",
      "description": "추출 시각"
    },
    "validatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "검증 시각"
    },
    "adoptedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "채택 시각"
    },
    "rejectedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "거부 시각"
    },
    "rejectionReason": {
      "type": ["string", "null"],
      "description": "거부 사유"
    }
  }
}
